# Copy this file to  .env  and fill in the value.
# .env is gitignored — the key never gets committed.

# From https://fal.ai/dashboard/keys  →  "Add key"
FAL_KEY=

# Optional, only for the voiceover step (https://elevenlabs.io → Profile → API key)
ELEVENLABS_API_KEY=

# REQUIRED for the webapp to generate anything. Every paid endpoint now
# demands a signed-in user unconditionally -- leaving these blank does NOT
# give you an open, no-login workspace, it means nobody (including you) can
# generate at all; the page and job history still load, that's all. See
# webapp/README.md's "Access control". When set, run 02-multiuser-schema.sql
# against this project first.
# The CLI (scripts/factory.py) is unaffected and needs only FAL_KEY.
#   SUPABASE_URL / SUPABASE_ANON_KEY: Project Settings -> API -> Project URL
#     and the "anon" / "public" key.
#   SUPABASE_SERVICE_ROLE_KEY: same page, the "service_role" secret key --
#     server-side only, never sent to the browser. Required for the webapp
#     to deduct or grant credits; auth and balance *reads* work without it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional -- lets signed-in users top up their own balance from the webapp
# instead of you granting credit manually. Each provider is independently
# opt-in: only fill in the block(s) you actually use, and the UI only shows
# a button for a provider once its own env vars below are all set. See
# PAYMENTS.md for how to get each of these and what still needs testing
# against the provider's own sandbox before going live.

# Stripe (https://dashboard.stripe.com/apikeys and /webhooks). Use the
# "sk_test_..." / "whsec_..." pair while testing, switch to live keys later.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Payme (https://business.payme.uz -- Merchant cabinet -> your project ->
# API settings). MERCHANT_KEY is the "test key" or "key" shown there --
# treat it like a password, never commit it.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# Click (https://my.click.uz -- merchant cabinet -> your service).
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme and Click bill in UZS; this project's credit balances are USD. No
# hardcoded fallback rate on purpose -- set this yourself so nobody is ever
# charged against a stale rate baked into the code. Plain number, e.g. 12800
# (so'm per 1 USD) -- check today's rate before setting it.
USD_TO_UZS_RATE=
